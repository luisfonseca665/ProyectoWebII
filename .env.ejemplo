# Configuración general de Django
# Te puedes basar en este archivo, pero cambia los valores

DJANGO_SECRET_KEY="django-insecure-cambia-esta-clave-secreta"
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_ENGINE=django.db.backends.mysql
DB_NAME=nombreDeLaDB
DB_USER=usuario
DB_PASSWORD=contraseña
